# ── Telegram API Credentials (from https://my.telegram.org) ──────────────
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# ── Telegram Bot Token (from @BotFather) ──────────────────────────────────
BOT_TOKEN=your_bot_token_here

# ── Telegram Channel & Admins ─────────────────────────────────────────────
STORAGE_CHANNEL_ID=-1001234567890
ADMIN_IDS=123456789,987654321

# ── Termux / Android Tuned Settings ───────────────────────────────────────
# Keep DOWNLOAD_DIR inside Termux $HOME (avoid /sdcard FUSE storage)
DOWNLOAD_DIR=bot_downloads
# Disk queue is safer on Android phones with limited RAM; set true to stream
ENABLE_STREAM_UPLOAD=false
STREAM_CONCURRENCY=1
DOWNLOAD_CONCURRENCY=2
MTPROTO_CONNECTIONS=2
STREAM_PROBE_BYTES=6291456

# ── Optional: Mistral AI (for smart titles & hashtags) ────────────────────
MISTRAL_API_KEY=

# ── Optional: Supabase (lightweight httpx REST client, no pydantic needed) ─
SUPABASE_URL=
SUPABASE_KEY=
